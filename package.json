{
  "name": "iobroker.dwd",
  "description": "Wetterwarnungen des Deutschen Wetterdienstes (DWD)",
  "version": "2.8.7",
  "author": {
    "name": "bluefox",
    "email": "dogafox@gmail.com"
  },
  "contributors": [
    {
      "name": "bluefox",
      "email": "dogafox@gmail.com"
    }
  ],
  "homepage": "https://github.com/ioBroker/ioBroker.dwd",
  "repository": {
    "type": "git",
    "url": "https://github.com/ioBroker/ioBroker.dwd.git"
  },
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "wetter",
    "weather",
    "home automation"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/build-tools": "^3.0.3",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.2.2",
    "@iobroker/types": "^7.2.3",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.4",
    "typescript": "~6.0.3"
  },
  "bugs": {
    "url": "https://github.com/ioBroker/ioBroker.dwd/issues"
  },
  "main": "build/main.js",
  "files": [
    "build/",
    "admin/",
    "widgets/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:ts && npm run build:widgets && npm run build:devices",
    "build:ts": "tsc -p tsconfig.build.json",
    "build:widgets": "node tasks.mts",
    "build:devices": "node tasks.mts --devices",
    "docs:images": "node docs/severity-colors.mjs",
    "prepublishOnly": "npm run build",
    "watch": "tsc -p tsconfig.build.json --watch",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tasks.json --noEmit",
    "lint": "node tasks.mts --install && eslint -c eslint.config.mjs src tasks.mts && cd src-widgets && npm run lint && cd ../src-devices && npm run lint",
    "test:package": "mocha test/packageFiles --exit",
    "test:integration": "mocha test/integrationAdapter --exit",
    "test": "npm run test:package",
    "translate": "translate-adapter -b admin/i18n/en.json",
    "npm": "npm i && cd src-widgets && npm i && cd ../src-devices && npm i",
    "release": "release-script --noPush -y",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "update-packages": "npx npm-check-updates --upgrade"
  },
  "readmeFilename": "README.md"
}
